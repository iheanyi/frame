{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frame",
  "version": "0.1.0",
  "identifier": "studio.frame.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run transport:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Frame",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "backgroundColor": "#18191b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/Frame/**",
          "$DOCUMENT/Frame/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/scrcpy-server",
      "resources/SCRCPY-LICENSE"
      ,"resources/scrcpy-server-v3.3.3"
      ,"resources/tango-runtime/"
      ,"resources/tango-helper/"
    ]
  }
}
