{
  "name": "frame-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "web:dev": "vite",
    "desktop:build": "tauri build",
    "transport:prepare": "node scripts/prepare-transport.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "studio:dev": "npm --prefix apps/web run dev -- --port 3001",
    "studio:build": "npm --prefix apps/web run build",
    "editor:sync": "node scripts/sync-editor-core.mjs --web=apps/web",
    "editor:check": "node scripts/sync-editor-core.mjs --web=apps/web --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "license": "Apache-2.0"
}
